{
    "private": true,
    "engines": {
        "node": ">=22.18.0"
    },
    "source": [
        "src/index.html",
        "src/transfer.html",
        "src/privacy.html"
    ],
    "scripts": {
        "test": "jest",
        "start": "parcel",
        "starttls": "parcel --cert ./dev_cert/cert.pem --key ./dev_cert/key.pem",
        "build": "parcel build",
        "release": "rm -rf dist && parcel build --no-cache && node scripts/version.mjs dist && node scripts/source.mjs dist home",
        "release:public": "rm -rf dist-public && parcel build --dist-dir dist-public --no-cache && node scripts/flavor.mjs dist-public public && node scripts/version.mjs dist-public && node scripts/source.mjs dist-public public"
    },
    "devDependencies": {
        "@babel/core": "^7.29.7",
        "@babel/plugin-transform-modules-commonjs": "^7.29.7",
        "@parcel/packager-raw-url": "^2.16.4",
        "@parcel/transformer-webmanifest": "^2.16.4",
        "babel-jest": "^30.5.2",
        "fake-indexeddb": "^6.2.6",
        "jest": "^30.5.2",
        "jest-environment-jsdom": "^30.5.2",
        "parcel": "^2.16.4",
        "process": "^0.11.10"
    },
    "allowScripts": {
        "@parcel/watcher": false,
        "@swc/core": false,
        "lmdb": false,
        "msgpackr-extract": false,
        "unrs-resolver": false
    },
    "name": "infergno",
    "dependencies": {
        "@cloudflare/realtimekit": "2.0.4"
    },
    "targets": {
        "default": {
            "context": "browser",
            "includeNodeModules": true
        }
    }
}
